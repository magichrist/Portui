/* ==========================================================================
   Ports Explorer — Female Cyber Space design system (TUI-Maker)

   ALL styling lives here. Widget-level `DEFAULT_CSS` is deliberately avoided:
   Textual only reliably applies App CSS, so this file is the single source of
   truth for layout and colour. Use the $role-* variables for semantics:

     $role-border   GUMMY_PINK   borders / dividers only (reads red as text)
     $role-accent   LIGHT_PINK   hints, labels and pink text
     $role-focus    AMBER        focused input border, warning accents
     $role-header   PHOSPHOR     panel headers, names, success
     $role-selection YELLOW      selected row / active text
     $role-hover    HOVER_BG     hovered row

   The base palette comes from App.get_css_variables(); never bake a hex value
   into this file, or live theme switching will stop working.
   ========================================================================== */

Screen {
    background: $surface;
    color: $cotton;
}

/* ── Branded header ─────────────────────────────────────────────────── */

#app-header {
    dock: top;
    height: 1;
    background: $surface-raised;
}

#header-title {
    width: 1fr;
    padding: 0 2;
    content-align: left middle;
}

#header-subtitle {
    width: auto;
    padding: 0 2;
    content-align: right middle;
    color: $role-accent;
}

/* ── Banner (breadcrumb + back button) ──────────────────────────────── */

#banner {
    height: 1;
    background: $surface-alt;
}

#back-button {
    width: auto;
    min-width: 10;
    height: 1;
    margin: 0 0 0 1;
    padding: 0 1;
    background: $surface-raised;
    color: $role-accent;
    text-style: bold;
    border: none;
}

#back-button:hover {
    background: $secondary;
    color: $surface;
}

#back-button:focus {
    background: $secondary;
    color: $surface;
    text-style: bold;
}

#breadcrumb {
    width: 1fr;
    padding: 0 1;
    content-align: left middle;
}

/* ── Search ─────────────────────────────────────────────────────────── */

Input {
    background: $surface-alt;
    border: tall $role-border;
    color: $cotton;
}

Input:focus {
    border: tall $role-focus;
}

Input > .input--placeholder {
    color: $muted;
}

/* ── Tables ─────────────────────────────────────────────────────────── */

DataTable {
    background: $surface;
    color: $cotton;
}

DataTable > .datatable--header {
    background: $surface-raised;
    color: $role-header;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $surface-raised;
    color: $role-selection;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: $role-hover;
    color: $role-selection;
}

DataTable > .datatable--odd-row {
    background: $surface-alt 60%;
}

DataTable > .datatable--even-row {
    background: $surface;
}

/* ── Status bar ─────────────────────────────────────────────────────── */

StatusBar {
    dock: bottom;
    height: 1;
    background: $surface-alt;
    color: $muted;
}

StatusBar #status-counts {
    width: 1fr;
    padding: 0 2;
}

StatusBar #status-health {
    width: auto;
    padding: 0 2;
}

StatusBar #status-keys {
    width: auto;
    padding: 0 2;
}

HealthBadge {
    height: 1;
    padding: 0 1;
    content-align: left middle;
}

/* ── Process list ───────────────────────────────────────────────────── */

ProcessListScreen {
    height: 1fr;
}

ProcessListScreen #process-search-row {
    height: 3;
    padding: 0 1;
}

ProcessListScreen.-narrow #process-grid {
    scrollbar-size-vertical: 1;
}

ProcessListScreen #process-empty {
    display: none;
}

ProcessListScreen.-empty #process-empty {
    display: block;
}

/* ── Process detail ─────────────────────────────────────────────────── */

ProcessDetailScreen {
    height: 1fr;
}

ProcessDetailScreen #detail-tabs {
    height: 1fr;
}

ProcessDetailScreen #overview-pane {
    padding: 0 1;
}

#detail-title {
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
    color: $role-header;
    text-style: bold;
}

MetricGrid {
    layout: grid;
    grid-size: 4;
    grid-columns: 1fr 1fr;
    grid-rows: 2;
    grid-gutter: 0 2;
    height: auto;
    margin: 0 0 1 0;
}

MetricGrid.-compact {
    grid-size: 2;
}

MetricGrid.-narrow {
    grid-size: 1;
}

Metric {
    height: 2;
    padding: 0 1;
    border-left: thick $role-border;
    background: $surface-alt;
    content-align: left middle;
    overflow: hidden;
}

Metric .metric-label {
    color: $role-accent;
}

Metric .metric-value {
    text-style: bold;
}

Metric.-missing {
    border-left: thick $muted;
}

#command-line {
    height: auto;
    max-height: 8;
    padding: 1 2;
    margin: 0 0 1 0;
    border: round $role-border;
    background: $surface-alt;
    color: $cotton;
}

#collection-note {
    height: auto;
    padding: 0 1;
    margin: 0 0 1 0;
    border-left: thick $role-focus;
    color: $role-focus;
}

#collection-note.-error {
    border-left: thick $danger;
    color: $danger;
}

/* ── Reusable resource table ────────────────────────────────────────── */

ResourceTable {
    height: 1fr;
}

ResourceTable > .resource-search {
    height: 3;
    margin: 0 0 1 0;
    display: none;
}

ResourceTable.-searching > .resource-search {
    display: block;
}

ResourceTable DataTable {
    height: 1fr;
}

ResourceTable .resource-empty {
    height: auto;
    padding: 1 2;
    display: none;
}

ResourceTable.-empty .resource-empty {
    display: block;
}

/* ── Empty / error states ───────────────────────────────────────────── */

.empty-state {
    height: 1fr;
    content-align: center middle;
    padding: 2 4;
}

/* ── Resource browser / detail ──────────────────────────────────────── */

ResourceBrowserScreen {
    height: 1fr;
}

ResourceBrowserScreen #browser-search-row {
    height: 3;
    padding: 0 1;
}

ResourceBrowserScreen #browser-empty {
    display: none;
}

ResourceBrowserScreen.-empty #browser-empty {
    display: block;
}

ResourceDetailScreen {
    height: 1fr;
}

#resource-detail {
    height: 1fr;
    border: round $role-border;
    background: $surface-alt;
    margin: 0 2 1 2;
    padding: 1 2;
    overflow-y: auto;
}

/* ── Theme picker ───────────────────────────────────────────────────── */

ThemeSwatch {
    height: 1;
    margin: 0 0 1 0;
}

ThemePickerScreen {
    height: 1fr;
}

ThemePickerScreen #theme-preview {
    height: auto;
    margin: 0 2 1 2;
    padding: 1 2;
    border: round $role-border;
    background: $surface-alt;
}

ThemePickerScreen #theme-preview-name {
    color: $role-header;
    text-style: bold;
}

/* ── Tabs / categories ──────────────────────────────────────────────── */

TabbedContent {
    height: 1fr;
}

Tabs {
    background: $surface-alt;
}

Tab {
    color: $muted;
}

Tab.-active {
    color: $role-header;
    text-style: bold;
}

Underline > .underline--bar {
    color: $role-border;
}

/* ── Footer ─────────────────────────────────────────────────────────── */

Footer {
    background: $surface-alt;
}

Footer > .footer-key--key {
    background: $secondary;
    color: $surface;
}

Footer > .footer-key--description {
    background: $surface-alt;
    color: $cotton;
}

/* ── Responsive ──────────────────────────────────────────────────────────
   Textual's TCSS has no @media support, so the app toggles the classes below
   from on_resize handlers in screens/common.py:ResponsiveMixin. The metric
   grid handles -compact / -narrow in its own block above. Breakpoints:
   -compact below 100 columns, -narrow below 76 columns.                    */

.-compact #header-subtitle {
    display: none;
}

.-narrow #breadcrumb {
    display: none;
}

.-narrow #back-button {
    min-width: 4;
}

.-narrow StatusBar #status-keys {
    display: none;
}

.-compact ProcessListScreen #process-grid,
.-narrow ProcessListScreen #process-grid {
    scrollbar-size-vertical: 1;
}
